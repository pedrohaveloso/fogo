{
  "name": "fogo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "start:fresh": "node src/server/main.ts --reset",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "geo": "node scripts/build-geo.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "maplibre-gl": "6.14.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.29.2"
}
